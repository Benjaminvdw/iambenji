# Safe to expose in the browser:
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_SPOTIFY_NOW_PLAYING_ENDPOINT=/api/spotify-now-playing
VITE_VISITOR_COUNT_ENDPOINT=/api/visitor-count

# Cloudflare Pages Function secrets:
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Cloudflare KV binding name for the visitor counter:
# VISITOR_COUNTER

# Cloudflare KV binding name for post-it notes:
# POST_ITS

# Cloudflare KV binding name for diary entries:
# DIARY_ENTRIES

# Admin password for /admin (server-side only, never use VITE_ prefix):
ADMIN_PASSWORD=your_admin_password_here

# Resend API key for the contact form (keep server-side only, never use VITE_ prefix):
RESEND_API_KEY=your_resend_api_key_here
